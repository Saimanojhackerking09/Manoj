/* =========================================
   JARVIS BACKGROUND
========================================= */

body{

    background:

    radial-gradient(
        circle at 50% 30%,
        rgba(255,50,20,.12),
        transparent 35%
    ),

    radial-gradient(
        circle at 80% 80%,
        rgba(255,180,0,.08),
        transparent 30%
    ),

    #050607;
}


/* GRID */

body::before{

    content:"";

    position:fixed;

    inset:0;

    pointer-events:none;

    z-index:-5;

    background-image:

    linear-gradient(
        rgba(255,60,20,.045) 1px,
        transparent 1px
    ),

    linear-gradient(
        90deg,
        rgba(255,60,20,.045) 1px,
        transparent 1px
    );

    background-size:
    50px 50px;

    mask-image:
    linear-gradient(
        to bottom,
        black,
        transparent
    );
}


/* SCAN LINE */

body::after{

    content:"";

    position:fixed;

    left:0;

    width:100%;

    height:2px;

    background:
    linear-gradient(
        90deg,
        transparent,
        #ff2a00,
        transparent
    );

    opacity:.4;

    z-index:999;

    animation:
    scan 6s linear infinite;

    pointer-events:none;
}

@keyframes scan{

    0%{
        top:-5px;
    }

    100%{
        top:100%;
    }
}


/* =========================================
   PARTICLES
========================================= */

.particles{

    position:fixed;

    inset:0;

    pointer-events:none;

    z-index:-1;
}

.particle{

    position:absolute;

    width:2px;
    height:2px;

    background:#ff3b18;

    box-shadow:
    0 0 8px #ff3b18;

    animation:
    particleUp linear infinite;
}

@keyframes particleUp{

    from{
        transform:
        translateY(110vh);
        opacity:0;
    }

    20%{
        opacity:1;
    }

    80%{
        opacity:1;
    }

    to{
        transform:
        translateY(-20vh);
        opacity:0;
    }
}


